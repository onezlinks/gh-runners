# GitHub self-hosted runner configuration
# Copy to .env and fill in your values: cp .env.example .env

# --- Required ---

# Target for the runner:
#   owner/repo  → repository-level runner
#   owner       → organization-level runner (serves all repos allowed by its runner group)
REPO=owner/repo

# Personal access token used to mint registration/remove tokens automatically.
#   repo runner : classic PAT with `repo` scope (or fine-grained Administration: write on the repo)
#   org runner  : PAT with `admin:org` (or fine-grained Organization runners: write)
GH_PAT=

# Alternative to GH_PAT: a registration token from
# https://github.com/<owner>/<repo>/settings/actions/runners/new
# Expires after ~1 hour — only use for one-off/manual setups, not restart: always.
# REG_TOKEN=

# --- Optional ---

# Base name for runners. The container hostname is appended, so every replica
# registers a unique name like "my-runner-a1b2c3d4e5f6".
# Defaults to the repo/org name.
# NAME=my-runner

# Comma-separated extra labels (e.g. self-hosted,linux,x64,gpu)
# LABELS=

# Runner group (org/enterprise runners only)
# RUNNER_GROUP=Default

# Custom workspace directory inside the container
# WORK_DIR=_work

# Register as ephemeral — runner deregisters itself after running one job
# EPHEMERAL=false

# Prevent the runner from auto-updating itself
# DISABLE_AUTO_UPDATE=false
